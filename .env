# ==============================================================================
# Oracle Cloud Infrastructure (OCI) Configuration
# ==============================================================================

# Go to Profile -> Tenancy (Tenancy information OCID) and copy it here
TENANCY_ID="ocid1.tenancy.oc1..***"

# Check README.md step 7 (ARM-compatible image OCID: Ubuntu, Oracle Linux, etc.)
IMAGE_ID="ocid1.image.oc1.***.***"

# Check README.md step 8 (Public Subnet OCID)
SUBNET_ID="ocid1.subnet.oc1.***.***"

# Check README.md step 9 (Availability Domain, e.g. Uocm:SA-VINHEDO-1-AD-1)
AVAILABILITY_DOMAIN="JtDP:***"

# Internal container path to your public SSH key
PATH_TO_PUBLIC_SSH_KEY="/root/.oci/chave_vps_arm.pub"

# ==============================================================================
# Instance Resources (Always Free Tier limits: up to 4 OCPUs, 24GB RAM, 200GB disk)
# ==============================================================================
cpus=4
ram=24
bootVolume=100
requestInterval=60
# DISPLAY_NAME="big-arm"
# OCI_PROFILE="DEFAULT"

# ==============================================================================
# Notification Webhook (Optional - WhatsApp, Discord, Telegram, etc.)
# ==============================================================================
# Exemplo para WhatsApp API (Evolution API, Z-API, Baileys, etc.) ou Discord/Slack:
# NOTIFICATION_WEBHOOK_URL="https://api.exemplo.com/message/sendText/sua-instancia"
# NOTIFICATION_WEBHOOK_METHOD="POST"
# NOTIFICATION_WEBHOOK_HEADERS="Content-Type: application/json; apikey: seu-token-aqui"
# NOTIFICATION_WEBHOOK_BODY='{"number": "5511999999999", "text": "{message}"}'
NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_METHOD="POST"
NOTIFICATION_WEBHOOK_HEADERS=""
NOTIFICATION_WEBHOOK_BODY=""